{
  "name": "fastrmemory-vscode",
  "displayName": "FastrMemory Guardian (VS Code & Cursor)",
  "description": "Native status bar pill & active error trap underlines for VS Code and Cursor",
  "version": "0.8.1",
  "publisher": "atifjubaer",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/atifjubaer/fastrmemory"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "fastrmemory",
    "ai",
    "memory",
    "error-trap",
    "cursor",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fastrmemory.showTraps",
        "title": "FastrMemory: Show Active Error Traps",
        "category": "FastrMemory"
      },
      {
        "command": "fastrmemory.openDashboard",
        "title": "FastrMemory: Open 3D Brain Observatory",
        "category": "FastrMemory"
      },
      {
        "command": "fastrmemory.guardWorkspace",
        "title": "FastrMemory: Run Pre-Merge Trap Guardian",
        "category": "FastrMemory"
      }
    ],
    "configuration": {
      "title": "FastrMemory",
      "properties": {
        "fastrmemory.enableUnderlines": {
          "type": "boolean",
          "default": true,
          "description": "Highlight trapped code files and lines with amber warning underlines"
        },
        "fastrmemory.serverPort": {
          "type": "number",
          "default": 4242,
          "description": "Port for FastrMemory 3D Observatory UI server"
        },
        "fastrmemory.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the fastrmemory CLI (a binary, or its dist/bin/fastr.js entry point, run with the system `node`). Empty = auto-detect: workspace node_modules, then a global npm install on PATH."
        },
        "fastrmemory.guardBaseBranch": {
          "type": "string",
          "default": "origin/main",
          "description": "Base branch passed to `fastrmemory guard --base` by the Pre-Merge Trap Guardian command"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  }
}
