{
  "name": "@atifjubaer/fastrmemory",
  "version": "0.1.0",
  "description": "High-Performance Cognitive Agent Memory Engine with Bi-Temporal SQLite and Official MCP v2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atifjubaer/fastrmemory.git"
  },
  "homepage": "https://github.com/atifjubaer/fastrmemory#readme",
  "bugs": {
    "url": "https://github.com/atifjubaer/fastrmemory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "dist-ui",
    "skills",
    ".claude-plugin",
    ".cursor"
  ],
  "bin": {
    "fastrmemory": "dist/bin/fastr.js",
    "fastr": "dist/bin/fastr.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./mcp": "./dist/src/mcp/server.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "prepare": "npm run build:ui && tsc",
    "prepublishOnly": "npm run build && npm test",
    "build:ui": "npm --prefix ui run build",
    "build:extension": "tsc -p extensions/vscode",
    "build": "npm run build:ui && tsc",
    "build:all": "npm run build && npm run build:extension",
    "watch": "tsc --watch",
    "test": "vitest run",
    "start": "node dist/bin/fastr.js"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "mcp",
    "sqlite",
    "bitemporal",
    "claude-code",
    "cursor"
  ],
  "author": "Fastrsoft",
  "license": "Apache-2.0",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "commander": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
