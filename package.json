{
  "name": "@atifjubaer/fastrmemory",
  "version": "0.2.1",
  "mcpName": "io.github.atifjubaer/fastrmemory",
  "description": "High-Performance Cognitive Agent Memory Engine with Bi-Temporal SQLite and Official MCP v2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atifjubaer/fastrmemory.git"
  },
  "homepage": "https://github.com/atifjubaer/fastrmemory#readme",
  "bugs": {
    "url": "https://github.com/atifjubaer/fastrmemory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "dist-ui",
    "skills",
    ".claude-plugin",
    ".cursor"
  ],
  "bin": {
    "fastrmemory": "dist/bin/fastr.js",
    "fastr": "dist/bin/fastr.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./mcp": "./dist/src/mcp/server.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "prepare": "npm run build:core",
    "prepublishOnly": "npm run build:core && npm test && npm run check:dist-ui && npm run check:package",
    "build:core": "tsc",
    "build:ui": "npm --prefix ui run build && node scripts/build-dist-ui-manifest.mjs",
    "build:extension": "tsc -p extensions/vscode",
    "build": "npm run build:core && npm run build:ui",
    "build:all": "npm run build && npm run build:extension",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:isolation": "vitest run tests/isolation.test.ts",
    "test:crash": "node scripts/crash-test.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:dist-ui": "node scripts/check-dist-ui.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:crash": "node scripts/check-crash-evidence.mjs",
    "bench": "tsx scripts/eval-bench.ts --split all --embeddings minilm --out bench/results/minilm.json",
    "bench:hash": "tsx scripts/eval-bench.ts --split all --embeddings hash --out bench/results/hash.json",
    "bench:legacy": "tsx scripts/capture-bench.ts",
    "bench:verify": "node scripts/check-bench.mjs",
    "verify:replay": "tsx scripts/verify-replay.ts",
    "check:ci": "npm run test && npm run test:isolation && npm run check:skills && npm run check:dist-ui && npm run check:package && npm run verify:replay && npm run check:docs && npm run check:crash && npm run bench:verify",
    "start": "node dist/bin/fastr.js"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "mcp",
    "sqlite",
    "bitemporal",
    "claude-code",
    "cursor"
  ],
  "author": "Fastrsoft",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "commander": "^13.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
